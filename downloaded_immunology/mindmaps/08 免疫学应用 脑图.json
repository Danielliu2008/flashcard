{
  "name": "免疫学病理及应用",
  "children": [
    {
      "name": "超敏反应",
      "children": [
        {
          "name": "超敏反应概述",
          "children": [
            {
              "name": "定义：生理功能紊乱或组织损伤的特异性免疫应答"
            },
            {
              "name": "诱发条件：再次接受相同抗原刺激"
            }
          ]
        },
        {
          "name": "I型超敏反应",
          "children": [
            {
              "name": "又称：变态反应、速发型超敏反应、过敏"
            },
            {
              "name": "机制：IgE介导，体液免疫"
            },
            {
              "name": "主要成分：变应原、变应素IgE（粘膜下固有层B细胞产生）"
            },
            {
              "name": "特征：发生快、消退快，功能紊乱为主，具个体差异和遗传倾向"
            },
            {
              "name": "相关疾病：湿疹、荨麻疹、哮喘、过敏性鼻炎"
            }
          ]
        },
        {
          "name": "II型超敏反应",
          "children": [
            {
              "name": "又称：细胞毒型"
            },
            {
              "name": "机制：IgM、IgG介导，体液免疫"
            }
          ]
        },
        {
          "name": "III型超敏反应",
          "children": [
            {
              "name": "又称：抗原抗体复合物型"
            },
            {
              "name": "机制：IgM、IgG介导，体液免疫"
            },
            {
              "name": "相关疾病：Arthus反应、血清病、肾小球肾炎、类风湿关节炎"
            }
          ]
        },
        {
          "name": "IV型超敏反应",
          "children": [
            {
              "name": "又称：迟发型超敏反应"
            },
            {
              "name": "机制：细胞免疫，Th1细胞为主、CTL"
            },
            {
              "name": "相关疾病：接触性皮炎、结核性损伤"
            }
          ]
        }
      ]
    },
    {
      "name": "自身免疫病",
      "children": [
        {
          "name": "基本概念",
          "children": [
            {
              "name": "自身免疫：机体对自身抗原产生免疫应答"
            },
            {
              "name": "自身免疫病：自身抗体或致敏淋巴细胞攻击自身组织导致损伤"
            }
          ]
        },
        {
          "name": "发病机制",
          "children": [
            {
              "name": "克隆清除缺陷：阴性选择机制失效，异常克隆存活"
            },
            {
              "name": "分子模拟机制：病原体与自身抗原结构相似交叉反应"
            }
          ]
        },
        {
          "name": "防治原则",
          "children": [
            {
              "name": "病变根本：免疫耐受异常"
            },
            {
              "name": "治疗策略：去除诱因、抑制自身免疫应答、重建特异性免疫耐受"
            }
          ]
        }
      ]
    },
    {
      "name": "肿瘤免疫",
      "children": [
        {
          "name": "学科定义与范畴",
          "children": [
            {
              "name": "研究方向：免疫系统与肿瘤关系、免疫逃逸及免疫治疗"
            },
            {
              "name": "交叉特性：整合免疫学、分子生物学与临床肿瘤学"
            }
          ]
        },
        {
          "name": "肿瘤的免疫原性",
          "children": [
            {
              "name": "定义：刺激机体产生免疫应答的能力"
            },
            {
              "name": "免疫逃逸：DAMP和抗原不足以诱导清除肿瘤的强大应答"
            }
          ]
        }
      ]
    }
  ]
}