            {
              "name": "免疫记忆：无"
            },
            {
              "name": "参与成分：组织屏障、多种固有免疫细胞和分子"
            },
            {
              "name": "功能比喻：稳固的城墙（非特异性应答）"
            }
          ]
        },
        {
          "name": "适应性免疫（后天获得）",
          "children": [
            {
              "name": "诱发因素：病原体的特定抗原成分"
