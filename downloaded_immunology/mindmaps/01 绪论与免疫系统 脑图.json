            {
              "name": "识别受体：T细胞受体（TCR）、B细胞受体（BCR）"
            },
            {
              "name": "免疫记忆：有"
            },
            {
              "name": "参与成分：T细胞、B细胞"
            },
            {
              "name": "功能比喻：精准的武器（特异性应答）"
