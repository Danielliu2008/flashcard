    {
      "name": "固有免疫与适应性免疫",
      "children": [
        {
          "name": "固有免疫（先天获得）",
          "children": [
            {
              "name": "诱发因素：病原体的共有成分"
            },
            {
              "name": "作用时相：数小时至数天发挥效应"
            },
            {
              "name": "识别受体：模式识别受体"
