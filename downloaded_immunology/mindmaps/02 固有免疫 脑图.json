{
  "name": "固有免疫",
  "children": [
    {
      "name": "概述与基本概念",
      "children": [
        {
          "name": "固有免疫定义",
          "children": [
            {
              "name": "别称: 天然免疫、非特异性免疫"
            },
            {
              "name": "定义: 机体在种系发育和进化过程中形成的天然防御功能"
            }
          ]
        },
        {
          "name": "固有免疫与获得性免疫对比",
          "children": [
            {
              "name": "时相: 固有免疫立即-96h，获得性免疫>96h"
            },
            {
              "name": "识别机制: 固有识别模式分子(PAMP/DAMP)，获得识别特异分子(antigen)"
            },
            {
              "name": "APC需求: 固有不需APC，获得需要APC"
            },
            {
              "name": "细胞克隆: 固有无细胞克隆产生，获得产生细胞克隆"
            },
            {
              "name": "免疫记忆: 固有不产生免疫记忆，获得产生免疫记忆"
            }
          ]
        }
      ]
    },
    {
      "name": "固有免疫系统组成",
      "children": [
        {
          "name": "组织屏障",
          "children": [
            {
              "name": "皮肤和粘膜屏障",
              "children": [
                {
                  "name": "物理屏障: 紧密连接上皮细胞、纤毛摆动及冲洗作用"
                },
                {
                  "name": "化学屏障: 不饱和脂肪酸、乳酸、胃酸、溶菌酶、抑菌肽、乳铁蛋白"
                },
                {
                  "name": "微生物屏障: 正常菌群竞争结合、竞争营养与分泌抑菌物质"
                }
              ]
            },
            {
              "name": "体内屏障",
              "children": [
                {
                  "name": "血脑屏障: 软脑膜、脉络丛毛细血管壁及星形胶质细胞组成"
                },
                {
                  "name": "血胎屏障: 基蜕膜和胎儿绒毛膜滋养层细胞组成"
                },
                {
                  "name": "其他体内屏障: 血胸腺屏障"
                }
              ]
            }
          ]
        },
        {
          "name": "固有免疫细胞",
          "children": [
            {
              "name": "髓系免疫细胞",
              "children": [
                {
                  "name": "单核/巨噬细胞: 吞噬杀伤病原微生物，分泌细胞因子"
                },
                {
                  "name": "中性粒细胞: 吞噬并杀伤病原微生物"
                },
                {
                  "name": "树突状细胞 (DC): 吞噬病原微生物，加工、提呈抗原"
                },
                {
                  "name": "粒细胞: 嗜酸、嗜碱及中性粒细胞"
                },
                {
                  "name": "肥大细胞: 参与抗感染与局部炎症反应"
                }
              ]
            },
            {
              "name": "固有淋巴样细胞 (ILC)",
              "children": [
                {
                  "name": "特征: 具淋巴细胞特征但不表达特异性抗原受体"
                },
                {
                  "name": "主要类型: ILC1、ILC2、ILC3、Lti、NK细胞"
                }
              ]
            },
            {
              "name": "固有样淋巴细胞",
              "children": [
                {
                  "name": "主要类型: NKT细胞、粘膜相关恒定T细胞、γδT细胞、B1细胞"
                },
                {
                  "name": "特点: 多样性有限，迅速响应不依赖克隆扩增"
                }
              ]
            },
            {
              "name": "NK细胞",
              "children": [
                {
                  "name": "功能: 直接杀伤、ADCC、激发抗瘤免疫、分泌细胞因子激活巨噬细胞"
                }
              ]
            }
          ]
        },
        {
          "name": "固有免疫分子",
          "children": [
            {
              "name": "补体系统"
