{
  "name": "肌肉系统",
  "children": [
    {
      "name": "肌肉组织分类",
      "children": [
        {
          "name": "骨骼肌",
          "children": [
            {
              "name": "特点: 随意肌，受意识控制"
            },
            {
              "name": "分布: 附着于骨骼，约占体重40%"
            }
          ]
        },
        {
          "name": "心肌",
          "children": [
            {
              "name": "特点: 不随意肌，具横纹"
            },
            {
              "name": "分布: 心壁和大血管起始部"
            }
          ]
        },
        {
          "name": "平滑肌",
          "children": [
            {
              "name": "特点: 不随意肌，无横纹"
            },
            {
              "name": "分布: 血管壁及内脏中空性器官壁"
            }
          ]
        }
      ]
    },
    {
      "name": "骨骼肌形态与构造",
      "children": [
        {
          "name": "形态分类",
          "children": [
            {
              "name": "长肌: 多见于四肢，肌束平行"
            },
            {
              "name": "短肌: 多见于躯干深层"
            },
            {
              "name": "扁肌: 呈薄片状，具保护作用"
            },
            {
              "name": "轮匝肌: 环形纤维，关闭孔裂"
            }
          ]
        },
        {
          "name": "基本构造",
          "children": [
            {
              "name": "肌腹: 肌性部分，有收缩能力"
            },
            {
              "name": "肌腱: 致密结缔组织，无收缩能力"
            }
          ]
        },
        {
          "name": "辅助装置",
          "children": [
            {
              "name": "筋膜: 分浅筋膜和深筋膜"
            },
            {
              "name": "滑膜囊: 减少肌与骨面摩擦"
            },
            {
              "name": "腱鞘: 包于肌腱外面的鞘管"
            }
          ]
        }
      ]
    },
    {
      "name": "骨骼肌微细结构",
      "children": [
        {
          "name": "肌纤维结构",
          "children": [
            {
              "name": "肌膜: 细胞膜"
            },
            {
              "name": "肌浆: 细胞质"
            },
            {
              "name": "肌浆网: 滑面内质网"
            }
          ]
        },
        {
          "name": "肌节 (Sarcomere)",
          "children": [
            {
              "name": "组成: 明带、暗带及1/2明带"
            },
            {
              "name": "粗肌丝: 主要含肌球蛋白"
            },
            {
              "name": "细肌丝: 含肌动蛋白等"
            }
          ]
        },
        {
          "name": "肌管系统",
          "children": [
            {
              "name": "横管 (T管): 垂直于肌原纤维"
            },
            {
              "name": "终池: 肌浆网两侧膨大部分"
            },
            {
              "name": "三联体: T管与两侧终池构成"
            }
          ]
        }
      ]
    },
    {
      "name": "骨骼肌收缩机制",
      "children": [
        {
          "name": "兴奋收缩偶联",
          "children": [
            {
              "name": "神经肌肉接头: 释放乙酰胆碱 (ACh)"
            },
            {
              "name": "Ca2+释放: 肌浆网释放Ca2+至肌浆"
            }
          ]
        },
        {
          "name": "肌丝滑动学说",
          "children": [
            {
              "name": "收缩表现: 肌节缩短，Z线靠近"
            },
            {
              "name": "能量来源: 直接利用ATP"
            }
          ]
        },
        {
          "name": "收缩形式",
          "children": [
            {
              "name": "等张收缩: 长度缩短而张力不变"
            },
            {
              "name": "等长收缩: 长度不变而张力增加"
            },
            {
              "name": "单收缩与强直收缩"
            }
          ]
        }
      ]
    },
    {
      "name": "全身骨骼肌配布与运动",
      "children": [
        {
          "name": "头颈肌",
          "children": [
            {
              "name": "咀嚼肌: 咬肌、颞肌、翼内肌、翼外肌"
            },
            {
              "name": "胸锁乳突肌: 单侧旋脸侧屈，双侧低头"
            }
          ]
        },
        {
          "name": "躯干肌",
          "children": [
            {
              "name": "背肌: 斜方肌、背阔肌、竖脊肌"
            },
            {
              "name": "胸肌: 胸大肌、胸小肌、前锯肌、肋间肌"
            },
            {
              "name": "腹肌: 腹直肌、腹内斜肌、腹外斜肌、腹横肌"
            },
            {
              "name": "膈肌: 胸腹腔分界，具三个裂孔"
            }
          ]
        },
        {
          "name": "上肢肌",
          "children": [
            {
              "name": "上肢带肌: 三角肌 (外展肩关节)"
            },
            {
              "name": "臂肌: 肱二头肌 (屈肘)、肱三头肌 (伸肘)"
            },
            {
              "name": "前臂肌与手肌"
            }
          ]
        },
        {
          "name": "下肢肌",
          "children": [
            {
              "name": "髋肌: 髂腰肌、臀大肌、臀中肌"
            },
            {
              "name": "大腿肌: 股四头肌 (伸膝)、大腿后群与内侧群"
            },
            {
              "name": "小腿肌: 小腿三头肌 (跖屈踝关节)"
            }
          ]
        }
      ]
    }
  ]
}