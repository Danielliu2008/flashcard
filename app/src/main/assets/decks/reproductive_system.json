      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "月经周期中子宫内膜功能层的三期组织学变化"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "以28天为例：①增生期（第5~14天，雌激素主导，内膜修复增厚至2~3mm）；②分泌期（第15~28天，孕激素+雌激素主导，内膜增厚至5~7mm，腺体弯曲分泌糖原富含营养）；③月经期（第1~4天，激素骤降内膜坏死脱落出血）。"
          }
        ]
      },
      "pointType": "机制综合",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "23",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "雌激素的靶器官生理作用汇总"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "促进卵巢卵泡发育；增加输卵管蠕动；促子宫肌层肥大及内膜增生期改变；宫颈黏液分泌增多变稀薄（拉丝度高）；阴道上皮角化糖原增加；维持女性乳腺导管发育及脂肪臀部分布。"
          }
        ]
      },
      "pointType": "生理功能定位",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "24",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "孕激素（孕酮）的靶器官生理作用汇总"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "促子宫内膜分泌期转变以利着床；降低子宫平滑肌兴奋性及对催产素敏感性（安胎）；宫颈黏液变稠形成黏液栓阻挡精子；促进乳腺腺泡发育；兴奋下丘脑体温调节中枢使基础体温升高0.3~0.5℃。"
          }
        ]
      },
      "pointType": "生理功能定位",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "25",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "下丘脑-腺垂体-卵巢轴（HPO轴）的双向反馈调节"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "平时中等浓度雌激素和孕激素负反馈抑制GnRH、FSH和LH；卵泡成熟排卵前持续高浓度雌激素产生独特“正反馈”，诱发LH峰导致排卵；排卵后黄体分泌孕酮重塑负反馈抑制。"
          }
        ]
      },
      "pointType": "机制综合",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "26",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "精子获能（Capacitation）的概念与生化机理"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "精子在穿过宫颈黏液、子宫和输卵管过程中，精浆去能蛋白脱落、质膜固醇外排、Ca2+内流增多，获得过度运动活性及顶体反应能力的过程，耗时约5~7小时。"
          }
        ]
      },
      "pointType": "机制综合",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "27",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "顶体反应（Acrosome Reaction）与透明带反应（多精受精阻断）"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "精子结合卵母细胞透明带ZP3受体诱发顶体外膜融合破裂，释放酶解开通路；精子入卵后卵细胞皮质颗粒脱颗粒释放水解酶交联修饰透明带（透明带反应），永久阻断其他精子进入。"
          }
        ]
      },
      "pointType": "机制综合",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "28",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "受精卵的早期卵裂与胚泡植入（着床）条件"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
