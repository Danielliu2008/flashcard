  "flashcards": [
    {
      "c": 1,
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "【传播途径】什么是水平传播与垂直传播？垂直传播常见病毒有哪些？"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "• **水平传播**：个体之间横向播散（呼吸道、消化道、血行、性接触、蚊虫）。\n• **垂直传播**：母体经胎盘、产道、哺乳传给子代（TORCH病原体：风疹、巨细胞、HSV，以及 HBV、HIV）。"
          }
        ]
      },
      "pointType": "传播途径",
      "starRating": "★★★",
      "importance": 3
    },
    {
