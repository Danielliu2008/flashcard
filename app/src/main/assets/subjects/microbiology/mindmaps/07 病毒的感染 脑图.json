{
  "name": "病毒的感染与免疫",
  "children": [
    {
      "name": "病毒感染的传播方式",
      "children": [
        {
          "name": "感染途径",
          "children": [
            {
              "name": "皮肤与黏膜: 呼吸道、消化道及泌尿生殖道等"
            },
            {
              "name": "血液循环: 输血、机械损伤或蚊虫叮咬等"
            }
          ]
        },
        {
          "name": "传播类型",
          "children": [
            {
              "name": "水平传播",
              "children": [
                {
                  "name": "定义: 人群不同个体间的传播"
                },
                {
                  "name": "范围: 人-人、动物-人及媒介传播"
                }
              ]
            },
            {
              "name": "垂直传播",
              "children": [
                {
                  "name": "定义: 亲代宿主传给子代的传播方式"
                },
                {
                  "name": "主要方式: 胎盘或产道传播"
                },
                {
                  "name": "围产期感染: 孕28周至产后4周由母传婴"
                },
                {
                  "name": "常见病毒: HIV、HBV、HCV及风疹病毒等"
                }
              ]
            }
          ]
        },
        {
          "name": "体内播散",
          "children": [
            {
              "name": "局部感染: 病毒仅在入侵部位局部组织增殖"
            },
            {
              "name": "全身感染: 经血流、淋巴液或神经系统向全身播散"
            },
            {
              "name": "病毒血症: 病毒进入血液循环状态"
            }
          ]
        }
      ]
    },
    {
      "name": "病毒感染的致病机制",
      "children": [
        {
          "name": "对宿主细胞的致病作用",
          "children": [
            {
              "name": "杀细胞效应",
              "children": [
                {
                  "name": "机制: 阻断细胞核酸与蛋白质合成"
                },
                {
                  "name": "常见病毒: 无包膜病毒如脊髓灰质炎病毒"
                },
                {
                  "name": "体外现象: 细胞变圆、坏死并脱落"
                }
              ]
            },
            {
              "name": "稳定状态感染",
              "children": [
                {
                  "name": "特征: 不引起细胞立即裂解死亡"
                },
                {
                  "name": "细胞融合: 形成多核巨细胞或合胞体"
                },
                {
                  "name": "表面新抗原: 细胞表面表达病毒编码抗原"
                }
              ]
            },
            {
              "name": "包涵体形成",
              "children": [
                {
                  "name": "特征: 细胞内可见斑块结构"
                },
                {
                  "name": "诊断应用: 狂犬病内氏小体"
                }
              ]
            },
            {
              "name": "细胞凋亡: 促进释放或限制病毒数量"
            },
            {
              "name": "基因整合与转化: 导致细胞转化为肿瘤细胞"
            }
          ]
        },
        {
          "name": "免疫病理作用",
          "children": [
            {
              "name": "抗体介导: Ⅱ型和Ⅲ型超敏反应损伤"
            },
            {
              "name": "细胞介导: CTL杀伤及Ⅳ型超敏反应"
            },
            {
              "name": "致炎细胞因子: 引发休克和DIC等过程"
            },
            {
              "name": "免疫抑制: 主动抑制宿主固有与适应性免疫"
            }
          ]
        },
        {
          "name": "病毒的免疫逃逸",
          "children": [
            {
              "name": "细胞内寄生: 逃避抗体及补体作用"
            },
            {
              "name": "抗原变异: 高频率变异导致免疫滞后"
            },
            {
              "name": "降低抗原表达: 抑制MHC-Ⅰ表达"
            },
            {
              "name": "免疫增强作用: 促进病毒进入单核细胞"
            }
          ]
        }
      ]
    },
    {
      "name": "病毒感染的类型",
      "children": [
        {
          "name": "有无临床症状",
          "children": [
            {
              "name": "隐性感染: 不引起临床症状，可获免疫力或成携带者"
            },
            {
              "name": "显性感染: 感染后出现明显的临床症状和体征"
            }
          ]
        }
      ]
    },
    {
      "name": "抗病毒免疫应答",
      "children": [
        {
          "name": "固有免疫",
          "children": [
            {
              "name": "物理屏障: 皮肤与黏膜及其分泌物"
            },
            {
              "name": "细胞作用: 巨噬细胞与NK细胞等"
            },
            {
              "name": "干扰素作用: 诱导细胞合成抗病毒蛋白"
            }
          ]
        },
        {
          "name": "适应性免疫",
          "children": [
            {
              "name": "体液免疫: 中和抗体清除细胞外病毒"
            },
            {
              "name": "细胞免疫: CTL杀伤靶细胞清除胞内病毒"
            }
          ]
        }
      ]
    }
  ]
}