{
  "name": "病毒的基本性状",
  "children": [
    {
      "name": "病毒的定义与独特性状",
      "children": [
        {
          "name": "病毒的定义",
          "children": [
            {
              "name": "非细胞结构型微生物，体积微小"
            },
            {
              "name": "遗传物质仅含DNA或RNA一种核酸"
            },
            {
              "name": "严格活细胞内寄生"
            },
            {
              "name": "以自我复制方式增殖"
            },
            {
              "name": "必须借助电子显微镜观察"
            }
          ]
        },
        {
          "name": "独特性状",
          "children": [
            {
              "name": "超显微结构，可通过除菌滤器"
            },
            {
              "name": "细胞外不能独立增殖"
            },
            {
              "name": "对抗生素不敏感，对干扰素敏感"
            }
          ]
        }
      ]
    },
    {
      "name": "病毒的大小与形态",
      "children": [
        {
          "name": "病毒的大小",
          "children": [
            {
              "name": "测量单位为纳米级（nm）"
            },
            {
              "name": "最大病毒：约300nm，如痘病毒"
            },
            {
              "name": "最小病毒：约20nm，如微小病毒"
            }
          ]
        },
        {
          "name": "病毒的形态",
          "children": [
            {
              "name": "多数呈球形或近似球形"
            },
            {
              "name": "少数呈丝状、砖块状、弹状、杆状"
            },
            {
              "name": "噬菌体呈蝌蚪状"
            }
          ]
        }
      ]
    },
    {
      "name": "病毒的结构与化学组成",
      "children": [
        {
          "name": "病毒的结构",
          "children": [
            {
              "name": "核衣壳：基本结构，含核心与衣壳"
            },
            {
              "name": "包膜：某些病毒外围的双层膜结构，具刺突"
            },
            {
              "name": "辅助结构：触须样纤维与被膜"
            }
          ]
        },
        {
          "name": "化学组成",
          "children": [
            {
              "name": "病毒核酸：DNA或RNA，主导感染与遗传"
            },
            {
              "name": "病毒蛋白质：结构蛋白与非结构蛋白"
            },
            {
              "name": "脂质和糖：主要存在于包膜中"
            }
          ]
        }
      ]
    },
    {
      "name": "病毒的增殖",
      "children": [
        {
          "name": "复制周期",
          "children": [
            {
              "name": "吸附：标志病毒感染的开始"
            },
            {
              "name": "穿入：病毒进入细胞内"
            },
            {
              "name": "脱壳：进入隐蔽期的开始"
            },
            {
              "name": "生物合成：合成核酸和蛋白质"
            },
            {
              "name": "装配、成熟与释放"
            }
          ]
        },
        {
          "name": "异常增殖",
          "children": [
            {
              "name": "顿挫感染：不能产生感染性子代病毒"
            },
            {
              "name": "缺陷病毒：基因组不完整需辅助病毒"
            }
          ]
        }
      ]
    }
  ]
}