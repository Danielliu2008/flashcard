{
  "name": "细菌的遗传与变异",
  "children": [
    {
      "name": "基本属性",
      "children": [
        {
          "name": "遗传性",
          "children": [
            {
              "name": "定义：亲代生物学特性通过遗传物质传递给子代"
            },
            {
              "name": "生理意义：保证物种的稳定性"
            }
          ]
        },
        {
          "name": "变异性",
          "children": [
            {
              "name": "定义：子代与亲代之间生物学特性出现的差异"
            },
            {
              "name": "变异根本：遗传信息的改变"
            },
            {
              "name": "生理意义：使物种更能适应外界环境并发生进化"
            },
            {
              "name": "发生特征：繁殖速度快且十分常见"
            }
          ]
        }
      ]
    },
    {
      "name": "细菌的变异现象",
      "children": [
        {
          "name": "形态与结构变异",
          "children": [
            {
              "name": "陈旧培养物中多见形态与染色特性变异"
            },
            {
              "name": "细胞壁缺陷：受抗生素、溶菌酶等影响导致缺陷"
            },
            {
              "name": "荚膜变异：肺炎链球菌多次传代后失去荚膜致病减弱"
            },
            {
              "name": "芽孢变异：炭疽芽孢杆菌42℃培养丧失形成芽孢能力"
            },
            {
              "name": "鞭毛变异：普通变形杆菌含苯酚培养基上失去鞭毛"
            }
          ]
        },
        {
          "name": "毒力变异",
          "children": [
            {
              "name": "包括毒力的增强、减弱和消失"
            },
            {
              "name": "卡介苗 (BCG)：牛分枝杆菌长期传代获得的高效免疫原性变异株"
            }
          ]
        },
        {
          "name": "菌落变异 (S-R变异)",
          "children": [
            {
              "name": "S型菌落：表面光滑、湿润、边缘整齐，致病性通常较强"
            },
            {
              "name": "R型菌落：表面粗糙、干燥、边缘不整齐"
            },
            {
              "name": "变异原因：细菌失去了表面多糖、荚膜等结构成分"
            }
          ]
        },
        {
          "name": "耐药性变异",
          "children": [
            {
              "name": "定义：细菌对某种抗菌药物由敏感变成耐药的现象"
            },
            {
              "name": "多重耐药 (MDR)：同时对多种抗菌药物耐药"
            }
          ]
        }
      ]
    },
    {
      "name": "细菌基因组结构",
      "children": [
        {
          "name": "细菌染色体 (核质)",
          "children": [
            {
              "name": "单倍体，呈环状或线性的双链DNA (dsDNA)"
            },
            {
              "name": "多数细菌为单条环状dsDNA (580~5220kb)"
            },
            {
              "name": "基因组特点：操纵子串联排列，非编码序列少，无内含子"
            }
          ]
        },
        {
          "name": "外源DNA片段",
          "children": [
            {
              "name": "耐药岛、致病岛/毒力岛与代谢岛"
            },
            {
              "name": "基因水平转移 (HGT)：种内和种间广泛存在"
            },
            {
              "name": "细菌致病岛 (PAI)：编码毒力因子的外源DNA片段"
            }
          ]
        },
        {
          "name": "质粒 (Plasmid)",
          "children": [
            {
              "name": "定义：染色体外具有独立复制能力的遗传物质"
            },
            {
              "name": "基本特征：自我复制、携带非必需基因、可自行丢失或被消除"
            },
            {
              "name": "不相容性：亲缘密切的质粒不能稳定共存同一宿主"
            },
            {
              "name": "接合性质粒：带有接合传递基因，如F质粒和R质粒"
            },
            {
              "name": "非接合性质粒：不能通过接合传递，分子量小"
            },
            {
              "name": "严紧型质粒：拷贝数低，与染色体同步复制"
            },
            {
              "name": "松弛型质粒：拷贝数高，自主控制复制"
            },
            {
              "name": "主要分类：F质粒、耐药性质粒、毒力质粒、细菌素质粒、代谢质粒"
            }
          ]
        },
        {
          "name": "噬菌体基因组",
          "children": [
            {
              "name": "温和噬菌体基因组可整合在细菌染色体上成为前噬菌体"
            }
          ]
        },
        {
          "name": "转座元件 (可移动元件)",
          "children": [
            {
              "name": "定义：不依赖同源重组即可改变自身位置的跳跃基因"
            },
            {
              "name": "介导者：由转座酶催化完成转座过程"
            },
            {
              "name": "种类：插入序列、转座子和整合子等"
            },
            {
              "name": "遗传意义：产生插入突变、基因重排及基因水平转移"
            }
          ]
        }
      ]
    },
    {
      "name": "噬菌体的生物学性状",
      "children": [
        {
          "name": "概念：感染细菌、真菌等微生物的病毒"
        },
        {
          "name": "基本特点：个体微小、无细胞结构、专性胞内寄生"
        },
        {
          "name": "分布：分布极广，存在于人和动物排泄物及污染水体中"
        }
      ]
    },
    {
      "name": "基因的转移与重组",
      "children": [
        {
          "name": "基因转移方式",
          "children": [
            {
              "name": "基因的垂直转移：亲代到子代的遗传"
            },
            {
              "name": "基因的水平转移 (HGT)：跨越亲缘关系的DNA交流"
            },
            {
              "name": "转化 (Transformation)：感受态细菌直接摄入DNA片段"
            },
            {
              "name": "接合 (Conjugation)：通过性菌毛传递质粒或染色体DNA"
            },
            {
              "name": "转导 (Transduction)：噬菌体介导的细菌基因转移"
            }
          ]
        },
        {
          "name": "基因重组类型",
          "children": [
            {
              "name": "同源重组：发生在序列相同或相近DNA片段之间的双向或单向交换"
            },
            {
              "name": "非同源重组：位点专一重组酶作用下的转座子或前噬菌体插入"
            }
          ]
        }
      ]
    }
  ]
}