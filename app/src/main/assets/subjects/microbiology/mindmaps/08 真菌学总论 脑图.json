              "name": "特异性免疫",
              "children": [
                {
                  "name": "细胞免疫：Th1应答占优势，抗深部真菌关键"
                },
                {
                  "name": "体液免疫：产生抗体用于调理吞噬与血清学诊断"
                }
              ]
            }
          ]
        }
