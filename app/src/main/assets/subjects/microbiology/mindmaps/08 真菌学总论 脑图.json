            {
              "name": "繁殖方式：有性或无性繁殖"
            }
          ]
        },
        {
          "name": "真菌分类",
          "children": [
            {
              "name": "形态结构分类",
              "children": [
                {
                  "name": "单细胞真菌：酵母型和类酵母型"
                },
                {
                  "name": "多细胞真菌：丝状真菌或霉菌"
                },
                {
                  "name": "双相型真菌：两种形态互变"
                }
              ]
            },
            {
              "name": "医学相关真菌门",
              "children": [
                {
                  "name": "子囊菌门：最大门，约占85%人类病原真菌"
                },
                {
                  "name": "担子菌门：包括食用菌和机会致病性真菌"
                },
                {
                  "name": "接合菌门：绝大多数为无隔、多核菌丝体"
                }
              ]
            }
          ]
        },
        {
          "name": "形态与结构",
          "children": [
            {
              "name": "单细胞真菌",
              "children": [
                {
                  "name": "酵母型真菌：不产生菌丝，芽生方式繁殖"
                },
                {
                  "name": "类酵母型真菌：可形成藕节状假菌丝"
                }
              ]
            },
            {
              "name": "多细胞真菌（霉菌）",
              "children": [
                {
                  "name": "菌丝分类：有隔菌丝与无隔菌丝"
                },
                {
                  "name": "菌丝体功能：营养菌丝、气中菌丝、生殖菌丝"
                },
                {
                  "name": "菌丝形态：结节状、球拍状、破梳状等"
                }
              ]
            },
            {
