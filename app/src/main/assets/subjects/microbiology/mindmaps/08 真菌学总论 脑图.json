                {
                  "name": "关节孢子：隔膜断裂形成"
                },
                {
                  "name": "厚膜孢子：充当休眠细胞"
                },
                {
                  "name": "大分生孢子：纺锤形、棍棒状等"
                },
                {
                  "name": "小分生孢子：单细胞，球形或卵形"
                },
                {
                  "name": "孢子囊孢子：囊内产生，如毛霉"
                }
              ]
            },
            {
              "name": "有性孢子",
              "children": [
                {
                  "name": "接合孢子、子囊孢子、担孢子、卵孢子"
                }
              ]
            },
            {
              "name": "真菌细胞结构",
              "children": [
                {
                  "name": "细胞壁：多糖占80%-90%（几丁质、葡聚糖）"
                },
                {
                  "name": "细胞膜：特有的麦角固醇"
                },
                {
                  "name": "核糖体：总体80S（60S加大亚基40S）"
                },
                {
                  "name": "荚膜：新生隐球菌荚膜与毒力相关"
                }
              ]
            }
          ]
        },
        {
