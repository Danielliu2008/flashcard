        {
          "name": "真菌免疫学",
          "children": [
            {
              "name": "非特异性免疫",
              "children": [
                {
                  "name": "皮肤黏膜屏障：不饱和脂肪酸具杀真菌作用"
                },
                {
                  "name": "正常菌群拮抗：防止菌群失调引起继发感染"
                },
