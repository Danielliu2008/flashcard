    {
      "name": "基本概念",
      "children": [
        {
          "name": "抗原加工",
          "children": [
            {
              "name": "定义：蛋白质抗原在细胞内降解为肽的过程"
            }
          ]
        },
        {
          "name": "抗原提呈",
          "children": [
            {
              "name": "定义：MHC分子结合抗原肽展示于细胞表面"
            }
          ]
        },
        {
          "name": "抗原提呈细胞 (APC)",
          "children": [
            {
              "name": "广义APC：机体所有有核细胞"
            },
            {
              "name": "专职APC：树突状细胞、巨噬细胞、B淋巴细胞"
            },
            {
              "name": "非专职APC：炎症状况下被诱导表达MHC II类分子"
            }
          ]
        }
      ]
    },
    {
      "name": "专职抗原提呈细胞",
      "children": [
        {
          "name": "树突状细胞 (DC)",
          "children": [
            {
              "name": "特点：激发初始T细胞能力最强"
            },
            {
              "name": "来源：骨髓造血干细胞"
            },
            {
              "name": "发育：未成熟DC向成熟DC迁移"
            }
          ]
        },
        {
          "name": "巨噬细胞",
          "children": [
            {
              "name": "功能：摄取、加工和提呈胞外抗原"
            }
          ]
        },
        {
          "name": "B淋巴细胞",
          "children": [
            {
              "name": "功能：对游离抗原识别与提呈"
            }
          ]
        }
      ]
    },
    {
      "name": "抗原加工处理与提呈途径",
      "children": [
        {
          "name": "内源性抗原加工提呈途径",
          "children": [
            {
              "name": "降解部位：蛋白酶体"
            },
            {
              "name": "转运蛋白：TAP"
            },
            {
              "name": "结合分子：MHC-I类分子"
            },
            {
              "name": "识别细胞：CD8+ T细胞"
            }
          ]
        },
        {
          "name": "外源性抗原加工处理途径",
          "children": [
            {
              "name": "捕获方式：巨噬细胞内吞"
            },
            {
              "name": "加工场所：内体与溶酶体"
            },
            {
              "name": "抗原肽长度：10-30个氨基酸"
            },
            {
              "name": "识别细胞：CD4+ T细胞"
            }
          ]
        }
      ]
    }
  ]
}