      "children": [
        {
          "name": "识别阶段",
          "children": [
            {
              "name": "非特异性结合: 粘附分子LFA-1和CD2"
            },
            {
              "name": "特异性结合: TCR识别pMHC并形成突触"
            }
          ]
        },
        {
          "name": "活化阶段",
