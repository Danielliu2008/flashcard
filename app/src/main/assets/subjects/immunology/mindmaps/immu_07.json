      "name": "免疫应答类型",
      "children": [
        {
          "name": "固有性免疫应答",
          "children": [
            {
              "name": "别称: 非特异性免疫应答"
            },
            {
              "name": "识别特点: 直接识别病原体PAMP"
            },
            {
              "name": "作用特点: 迅速产生，无免疫记忆"
            },
            {
              "name": "维持时间: 维持时间较短"
            },
            {
              "name": "主要成分: 吞噬细胞与NK细胞"
            }
          ]
        },
        {
          "name": "适应性免疫应答",
          "children": [
            {
              "name": "别称: 特异性免疫应答"
            },
            {
              "name": "识别特点: 识别抗原肽-MHC复合物"
            },
            {
              "name": "作用特点: 经克隆扩增，有免疫记忆"
            },
            {
              "name": "维持时间: 维持时间较长"
            },
            {
              "name": "细胞免疫应答: T细胞介导"
            },
            {
              "name": "体液免疫应答: B细胞介导"
            }
          ]
        }
      ]
    },
    {
