{
  "unit": "digestive_system",
  "title": "Unit 10 消化系统 核心解剖与生理闪卡",
  "flashcards": [
    {
      "c": "1",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "消化系统的组成"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "包括消化管（口腔、咽、食管、胃、小肠、大肠）和消化腺（唾液腺、肝、胰及消化管壁内微小腺体）。"
          }
        ]
      },
      "pointType": "核心概念",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "2",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "临床上消化道与下消化道的解剖分界"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "以屈氏韧带（Treitz韧带，十二指肠悬韧带）为界：口腔至十二指肠为上消化道；空肠、回肠、大肠为下消化道。"
          }
        ]
      },
      "pointType": "核心解剖结构",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "3",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "消化管壁的四层基本组织结构"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "由内向外依次为：①黏膜层（上皮、固有层、黏膜肌层）；②黏膜下层（疏松结缔组织、黏膜下神经丛）；③肌层（内环外纵，肌间神经丛）；④外膜（浆膜或纤维膜）。"
          }
        ]
      },
      "pointType": "组织学特征",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "4",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "小肠黏膜扩大吸收表面积的三大结构"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "①环状皱襞（黏膜+黏膜下层，扩大3倍）；②小肠绒毛（上皮+固有层，扩大10倍）；③微绒毛（细胞膜特化，扩大20倍）。总表面积达200m²。"
          }
        ]
      },
      "pointType": "生理功能定位",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "5",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "三大唾液腺及其开口位置"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "①腮腺：开口于上颌第2磨牙相对的颊黏膜；②下颌下腺：开口于舌下肉阜；③舌下腺：大管开口于舌下肉阜，小管开口于舌下襞。"
          }
        ]
      },
      "pointType": "核心解剖结构",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "6",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "牙的形态与组织结构"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "形态分牙冠、牙颈、牙根；组织由外向内为牙釉质（最硬）、牙本质（主体）、牙骨质，中央为容纳神经血管的牙髓腔。"
          }
        ]
      },
      "pointType": "核心解剖结构",
      "starRating": "★★☆",
      "importance": 2
    },
    {
      "c": "7",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "舌乳头的分类与味觉功能分布"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "丝状乳头（最多，司一般感觉，无味蕾）；菌状乳头、轮廓乳头（含味蕾，司味觉）；叶状乳头（退化）。"
          }
        ]
      },
      "pointType": "组织学特征",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "8",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "咽的分部与交通"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "分为鼻咽、口咽、喉咽三部分。鼻咽借咽鼓管咽口通中耳鼓室；口咽向前通口腔；喉咽向下通食管并向前经喉口通喉腔。"
          }
        ]
      },
      "pointType": "核心解剖结构",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "9",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "食管的三个生理性狭窄位置与临床意义"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "第1狭窄：食管起始部（环状软骨下缘，距中切牙15cm）；第2狭窄：与左主支气管交叉处（距切牙25cm）；第3狭窄：穿膈食管裂孔处（距切牙40cm）。异物易滞留、癌肿好发部位。"
          }
        ]
      },
      "pointType": "核心解剖结构",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "10",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "食管壁肌层的组织学渐变特征"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "食管上1/3段为骨骼肌；中1/3段为骨骼肌与平滑肌混杂；下1/3段完全为平滑肌。"
          }
        ]
      },
      "pointType": "组织学特征",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "11",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "胃的解剖分区与出入口"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "入口为贲门（接食管），出口为幽门（接十二指肠）。分为四部：贲门部、胃底、胃体、幽门部（幽门窦与幽门管）。幽门窦是溃疡好发区。"
          }
        ]
      },
      "pointType": "核心解剖结构",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "12",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "胃底腺三大主要细胞及其分泌产物"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "①壁细胞：分泌盐酸（HCl）和内因子；②主细胞：分泌胃蛋白酶原；③颈黏液细胞：分泌可溶性酸性黏液。"
          }
        ]
      },
      "pointType": "组织学特征",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "13",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "胃黏膜保护屏障（黏液-碳酸氢盐屏障）机制"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "胃表面上皮细胞分泌不溶性中性黏液凝胶层和HCO3-，在胃黏膜表面形成弱碱性保护层，阻止高浓度胃酸和胃蛋白酶逆向扩散侵蚀胃壁。"
          }
        ]
      },
      "pointType": "机制综合",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "14",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "内因子的生理作用及临床意义"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "由壁细胞分泌，特异性结合食糜中的维生素B12形成复合物，保护其不被消化酶破坏并在回肠末端吸收。内因子缺乏导致巨幼红细胞性贫血（恶性贫血）。"
          }
        ]
      },
      "pointType": "生理功能定位",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "15",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "胃酸（HCl）的主要生理作用"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "①激活胃蛋白酶原并提供最适酸性环境；②使食物蛋白质变性易于水解；③杀灭随食物进入的细菌；④促进胰液、胆汁和小肠液分泌；⑤促进小肠对铁和钙的吸收。"
          }
        ]
      },
      "pointType": "机制综合",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "16",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "胃排空的概念及排空速度排序"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "食糜由胃排入十二指肠的过程。三大营养素排空速度：糖类（最快） > 蛋白质 > 脂肪（最慢，促进抑胃肽分泌抑制排空）。"
          }
        ]
      },
      "pointType": "生理功能定位",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "17",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "十二指肠的分部与主要特征结构"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "分为上部、降部、水平部、升部。降部后内侧壁有十二指肠大乳头，为胆总管与胰管的共同开口；升部末端借十二指肠悬韧带（Treitz韧带）固定于后腹壁。"
          }
        ]
      },
      "pointType": "核心解剖结构",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "18",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "小肠的分部及空肠与回肠的鉴别要点"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "分十二指肠、空肠、回肠。空肠管径大、管壁厚、血管丰富色红润、黏膜皱襞密高、只有孤立淋巴滤泡；回肠管径小、壁薄、血管弓多级、出现特征性集合淋巴滤泡（Peyer斑）。"
          }
        ]
      },
      "pointType": "核心解剖结构",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "19",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "大肠的分部与盲肠结肠的三大特征结构"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "大肠包括盲肠、阑尾、结肠（升、横、降、乙状）、直肠和肛管。盲肠和结肠特有：结肠带、结肠袋、肠脂垂。"
          }
        ]
      },
      "pointType": "核心解剖结构",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "20",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "阑尾的根部体表投影点（麦氏点 McBurney点）"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "脐与右髂前上棘连线的中、外1/3交界处。急性阑尾炎时此处有明显的压痛和反跳痛。"
          }
        ]
      },
      "pointType": "核心解剖结构",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "21",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "肝脏的解剖分叶（膈面与脏面）"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "膈面借镰状韧带分为左叶和右叶；脏面有“H”形沟，分为左叶、右叶、方叶（前）和尾状叶（后）。横沟为肝门，有肝门静脉、肝固有动脉、肝左/右管出入。"
          }
        ]
      },
      "pointType": "核心解剖结构",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "22",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "肝门（第一肝门）出入结构的位置关系"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "从前向后依次为：肝管（左、右肝管）、肝固有动脉（左、右支）、肝门静脉（左、右支）。即“管、动、静”排列。"
          }
        ]
      },
      "pointType": "核心解剖结构",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "23",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "肝脏的双重血液供应系统"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "①营养性血管：肝固有动脉（含氧丰富，占供血量20%~25%）；②功能性血管：肝门静脉（含肠道吸收的丰富营养素和代谢物，占供血量75%~80%）。两者入肝后在肝血窦内混合。"
          }
        ]
      },
      "pointType": "核心解剖结构",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "24",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "肝小叶的基本结构组成"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "以中央静脉为中心，肝细胞索（肝板）呈放射状排列，索间为肝血窦（内含肝巨噬细胞/Kupffer细胞），肝索内相邻细胞间形成胆微管。相邻小叶之间为门管区（汇管区）。"
          }
        ]
      },
      "pointType": "组织学特征",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "25",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "门管区（汇管区）的三联结构"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "小叶间动脉（肝动脉分支）、小叶间静脉（门静脉分支）、小叶间胆管（收集胆汁）。"
          }
        ]
      },
      "pointType": "组织学特征",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "26",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "胆汁在非进食期（平时）的流经途径"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "肝细胞分泌 → 胆小管 → 小叶间胆管 → 左/右肝管 → 肝总管 → 胆囊管 → 胆囊（浓缩储存）。"
          }
        ]
      },
      "pointType": "机制综合",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "27",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "胆汁在进食期的排出途径"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "进食刺激迷走神经和CCK释放 → 胆囊收缩、Oddi括约肌舒张 → 胆囊内胆汁经胆囊管 + 肝细胞新分泌胆汁入肝总管 → 汇成胆总管 → 十二指肠大乳头 → 十二指肠腔。"
          }
        ]
      },
      "pointType": "机制综合",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "28",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "胆汁的主要成分及其生理功能"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "主要含水、胆盐、胆色素、胆固醇、卵磷脂等，不含消化酶。功能：乳化脂肪、激活胰脂肪酶、促进脂类及脂溶性维生素（A/D/E/K）吸收、中和胃酸。"
          }
        ]
      },
      "pointType": "生理功能定位",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "29",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "胰腺的解剖外形与位置"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "位于胃后方、腹后壁的腹膜外位器官。自右向左分为胰头（被十二指肠环抱）、胰颈、胰体、胰尾（紧邻脾门）。"
          }
        ]
      },
      "pointType": "核心解剖结构",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "30",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "胰液的主要成分及消化酶谱"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "最全面的消化液（pH 7.8~8.4），富含HCO3-（中和胃酸、保护黏膜）。酶谱包括：胰淀粉酶、胰脂肪酶、胰蛋白酶原、糜蛋白酶原、羧肽酶原、核糖核酸酶等。"
          }
        ]
      },
      "pointType": "机制综合",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "31",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "胰蛋白酶原与糜蛋白酶原的激活机制"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "肠致活酶（肠激酶）特异性剪切胰蛋白酶原生成有活性的胰蛋白酶；胰蛋白酶随后正反馈自我激活，并激活糜蛋白酶原生成糜蛋白酶。"
          }
        ]
      },
      "pointType": "机制综合",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "32",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "碳水化合物在小肠内的消化与吸收机制"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "淀粉经唾液与胰淀粉酶水解为麦芽糖、寡糖，微绒毛刷状缘麦芽糖酶/乳糖酶/蔗糖酶水解为单糖（葡萄糖、半乳糖通过SGLT-1继发性主动转运吸收，果糖通过GLUT-5易化扩散吸收）。"
          }
        ]
      },
      "pointType": "机制综合",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "33",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "蛋白质在消化道内的消化与吸收机制"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "胃蛋白酶初步分解为多肽 → 胰蛋白酶和糜蛋白酶分解为小肽和寡肽 → 氨肽酶与二肽酶水解为游离氨基酸和二肽/三肽 → 经Na+依赖性载体继发主动吸收进入小肠上皮。"
          }
        ]
      },
      "pointType": "机制综合",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "34",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "脂类在小肠内的消化与吸收机制"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "胆盐乳化脂肪微滴 → 胰脂肪酶水解甘油三酯为甘油一酯和游离脂肪酸 → 与胆盐形成混合微胶粒吸收 → 胞内重合成甘油三酯并组装成乳糜微粒（CM） → 入中央乳糜管经淋巴系统汇入血液。"
          }
        ]
      },
      "pointType": "机制综合",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "35",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "水与电解质在小肠与大肠的吸收"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "小肠吸收每日约8~9升水分中的大部分，以渗透方式伴随Na+、葡萄糖主动吸收而被动跨上皮转移；大肠吸收剩余的1~1.5升水分及Na+、Cl-，使排泄物成形。"
          }
        ]
      },
      "pointType": "生理功能定位",
      "starRating": "★★☆",
      "importance": 2
    },
    {
      "c": "36",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "肠道菌群及其生理功能"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "正常菌群主要存在于大肠，能利用肠内营养合成维生素K和B族维生素（B1、B2、B12、叶酸等），参与胆汁酸代谢，抑制外来病原菌定植繁殖。"
          }
        ]
      },
      "pointType": "生理功能定位",
      "starRating": "★★☆",
      "importance": 2
    },
    {
      "c": "37",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "胃肠道的神经支配（外来神经与内在神经系统）"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "外来神经：交感神经（抑制运动和分泌，缩血管）、副交感神经（迷走/盆神经，促进蠕动和分泌）。内在神经丛：肌间神经丛（主司蠕动）与黏膜下神经丛（主司腺体分泌与黏膜血流）。"
          }
        ]
      },
      "pointType": "机制综合",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "38",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "胃肠激素：胃泌素（Gastrin）的分泌与作用"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "主要由胃窦和十二指肠的G细胞分泌。作用：强烈刺激壁细胞分泌盐酸，促进主细胞分泌胃蛋白酶原，促进胃肠黏膜生长与胃窦蠕动。"
          }
        ]
      },
      "pointType": "生理功能定位",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "39",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "胃肠激素：促胰液素（Secretin）的分泌与作用"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "主要由十二指肠和空肠上段的S细胞在盐酸刺激下分泌。作用：强烈促进胰腺小导管上皮分泌大量富含水和HCO3-的胰液，中和进入十二指肠的胃酸。"
          }
        ]
      },
      "pointType": "生理功能定位",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "40",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "胃肠激素：胆囊收缩素（CCK）的分泌与作用"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "主要由十二指肠和空肠上段的I细胞在脂肪分解产物和氨基酸刺激下分泌。作用：促进胰腺腺泡分泌多种消化酶，促进胆囊强烈收缩排出胆汁，使Oddi括约肌舒张。"
          }
        ]
      },
      "pointType": "生理功能定位",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "41",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "肝脏的物质代谢核心功能"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "糖代谢（维持血糖恒定，合成与分解糖原、糖异生）；脂代谢（合成胆固醇、磷脂、脂蛋白并转化脂肪）；蛋白质代谢（合成除γ球蛋白外的几乎全部血浆蛋白、尿素循环消除血氨）。"
          }
        ]
      },
      "pointType": "生理功能定位",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "42",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "肝性脑病与肝脏尿素合成的关系"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "严重肝功能不全时，鸟氨酸循环受阻无法将有毒氨转化为尿素，血氨升高透过血脑屏障干扰脑细胞能量代谢与神经递质平衡，引发肝性脑病（昏迷）。"
          }
        ]
      },
      "pointType": "病理生理联系",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "43",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "门静脉高压症的三大侧支循环建立部位"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "①食管胃底静脉曲张（破裂易致致命性大出血）；②脐周腹壁静脉曲张（水母头征）；③直肠静脉曲张（痔静脉扩张破裂出血）。"
          }
        ]
      },
      "pointType": "病理生理联系",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "44",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "消化道平滑肌的电生理特性：慢波电位与动作电位"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "基本电节律（慢波电位）由Cajal间质细胞产生，决定胃肠平滑肌蠕动的方向与频率；当慢波去极化达阈电位时触发动作电位（Ca2+内流），引起平滑肌平滑收缩。"
          }
        ]
      },
      "pointType": "机制综合",
      "starRating": "★★☆",
      "importance": 2
    },
    {
      "c": "45",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "胃的运动形式：容受性舒张、紧张性收缩与蠕动"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "咀嚼和吞咽反射性引起胃底和胃体平滑肌舒张，称为容受性舒张（迷走-迷走神经反射，受肽能神经介导），使胃容积增大而压力不明显升高，利于容纳储存食物。"
          }
        ]
      },
      "pointType": "机制综合",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "46",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "小肠的特有运动形式：分节运动的生理意义"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "小肠环行肌交替舒缩形成的分节运动，不推进食糜，其意义在于使食糜与消化液充分混合、与小肠绒毛黏膜上皮密切接触促进吸收，并挤压肠壁促淋巴血液回流。"
          }
        ]
      },
      "pointType": "机制综合",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "47",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "移行性复合运动（MMC）的生理作用"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "消化间期出现周期的强力收缩复合波自胃向回肠末端推进，清除消化管内残留食物残渣、脱落细胞和过度细菌，防止小肠细菌逆行滋生，称为“清道夫”运动。"
          }
        ]
      },
      "pointType": "机制综合",
      "starRating": "★★☆",
      "importance": 2
    },
    {
      "c": "48",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "直肠的解剖结构与会阴深部毗邻"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "直肠全长约10~14cm，在矢状面上形成凸向后的骶曲和凸向前的会阴曲。男性直肠前邻膀胱底、精囊腺和前列腺；女性前邻子宫和阴道后壁。"
          }
        ]
      },
      "pointType": "核心解剖结构",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "49",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "腹膜与腹膜腔的解剖概念"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "壁腹膜衬覆腹壁内表面，脏腹膜包裹腹盆腔脏器。两者围成的潜在性裂隙为腹膜腔，男性完全封闭，女性借输卵管腹腔口与外界相通。"
          }
        ]
      },
      "pointType": "核心解剖结构",
      "starRating": "★★★",
      "importance": 3
    },
    {
      "c": "50",
      "f": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "腹膜内位器官、间位器官与外位器官举例"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "内位（表面几乎全被腹膜包裹）：胃、十二指肠上部、空肠、回肠、盲肠、阑尾、横结肠、乙状结肠、脾；间位（表面大部分被腹膜包裹）：肝、胆囊、升/降结肠、膀胱；外位（仅一面被腹膜覆盖）：肾、肾上腺、输尿管、胰、十二指肠降部和水平部。"
          }
        ]
      },
      "pointType": "核心解剖结构",
      "starRating": "★★★",
      "importance": 3
    }
  ]
}