          {
            "type": "text",
            "content": "【基本概念 · ★★★】\n成人全身共有多少块骨骼？"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "206块（其中6块听小骨属于感觉器）。"
          }
        ]
      },
      "c": 1,
      "pointType": "基本概念",
      "starRating": "★★★",
      "importance": 3
