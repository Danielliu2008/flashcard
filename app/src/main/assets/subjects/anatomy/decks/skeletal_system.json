          {
            "type": "text",
            "content": "【基本概念 · ★★★】\n按骨的形态分类，人体骨骼主要分为哪四种类型？"
          }
        ]
      },
      "b": {
        "flashcardContentBlock": [
          {
            "type": "text",
            "content": "长骨、短骨、扁骨和不规则骨。"
          }
        ]
      },
      "c": 2,
      "pointType": "基本概念",
      "starRating": "★★★",
      "importance": 3
    },
    {
