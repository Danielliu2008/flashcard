{
  "name": "骨学",
  "children": [
    {
      "name": "骨的概述",
      "children": [
        {
          "name": "骨的功能",
          "children": [
            {
              "name": "支持: 对抗重力并提供肌肉附着点"
            },
            {
              "name": "保护: 保护内部重要脏器"
            },
            {
              "name": "运动: 起杠杆作用，关节为枢纽"
            },
            {
              "name": "造血: 骨髓腔及松质骨间隙内的红骨髓具造血功能"
            },
            {
              "name": "储存矿物质: 体内99%的钙贮存于骨内"
            }
          ]
        },
        {
          "name": "骨的分类",
          "children": [
            {
              "name": "按部位",
              "children": [
                {
                  "name": "中轴骨: 包括颅骨和躯干骨"
                },
                {
                  "name": "附肢骨: 包括上肢骨和下肢骨"
                }
              ]
            },
            {
              "name": "按形态",
              "children": [
                {
                  "name": "长骨: 分布于四肢，呈长管状，分为一体两端"
                },
                {
                  "name": "短骨: 形似立方体，多成群分布于腕部和跗部"
                },
                {
                  "name": "扁骨: 呈板状，参与构成颅、胸和盆腔壁"
                },
                {
                  "name": "不规则骨: 形状不规则，如椎骨、上颌骨"
                },
                {
                  "name": "籽骨: 位于肌腱内的扁圆形小骨，如髌骨"
                }
              ]
            }
          ]
        },
        {
          "name": "骨的构造",
          "children": [
            {
              "name": "骨质",
              "children": [
                {
                  "name": "骨密质: 结构致密，抗压抗扭曲性强"
                },
                {
                  "name": "骨松质: 呈海绵状，由相互交织的骨小梁排列而成"
                }
              ]
            },
            {
              "name": "骨膜: 由纤维结缔组织构成，含丰富的血管和神经"
            },
            {
              "name": "骨髓",
              "children": [
                {
                  "name": "红骨髓: 具有造血和免疫功能"
                },
                {
                  "name": "黄骨髓: 失去造血能力，由脂肪组织代替"
                }
              ]
            }
          ]
        },
        {
          "name": "骨的化学成分和物理性质",
          "children": [
            {
              "name": "有机质: 主要为胶原纤维和黏多糖蛋白，赋予骨弹性和韧性"
            },
            {
              "name": "无机质: 主要为钙盐，赋予骨硬度"
            },
            {
              "name": "年龄比例变化: 成人比例约为3:7，老年人无机质比例增大易骨折"
            }
          ]
        }
      ]
    },
    {
      "name": "中轴骨",
      "children": [
        {
          "name": "躯干骨",
          "children": [
            {
              "name": "椎骨",
              "children": [
                {
                  "name": "颈椎: 共7块，第3-7椎体上有椎体钩，有横突孔"
                },
                {
                  "name": "胸椎: 共12块，椎体两侧有肋凹和横突肋凹"
                },
                {
                  "name": "腰椎: 共5块，椎体粗壮呈肾型"
                },
                {
                  "name": "骶骨: 由5块骶椎融合而成"
                },
                {
                  "name": "尾骨: 由3-4块尾椎融合而成"
                }
              ]
            },
            {
              "name": "胸骨",
              "children": [
                {
                  "name": "胸骨柄: 上缘两侧有锁切迹"
                },
                {
                  "name": "胸骨体: 两侧边缘有肋切迹"
                },
                {
                  "name": "剑突: 位于胸骨下端"
                }
              ]
            },
            {
              "name": "肋骨: 共12对，分为真肋、假肋和浮肋"
            }
          ]
        },
        {
          "name": "颅骨",
          "children": [
            {
              "name": "脑颅骨: 共8块，包括额骨、枕骨、蝶骨、筛骨及成对的顶骨和颞骨"
            },
            {
              "name": "面颅骨: 共15块，包括上颌骨、颧骨、鼻骨、泪骨、腭骨、下鼻甲、犁骨、下颌骨和舌骨"
            }
          ]
        }
      ]
    },
    {
      "name": "附肢骨",
      "children": [
        {
          "name": "上肢骨",
          "children": [
            {
              "name": "上肢带骨: 包括锁骨和肩胛骨"
            },
            {
              "name": "自由上肢骨: 包括肱骨、尺骨、桡骨、腕骨、掌骨和指骨"
            }
          ]
        },
        {
          "name": "下肢骨",
          "children": [
            {
              "name": "下肢带骨: 即髋骨，由髂骨、耻骨和坐骨融合而成"
            },
            {
              "name": "自由下肢骨: 包括股骨、髌骨、胫骨、腓骨、跗骨、跖骨和趾骨"
            }
          ]
        }
      ]
    }
  ]
}