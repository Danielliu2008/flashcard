{
  "name": "内分泌系统",
  "children": [
    {
      "name": "基本概念与分类",
      "children": [
        {
          "name": "内分泌细胞",
          "children": [
            {
              "name": "定义: 具有内分泌功能的细胞"
            },
            {
              "name": "内分泌组织: 由内分泌细胞构成的组织"
            }
          ]
        },
        {
          "name": "内分泌腺",
          "children": [
            {
              "name": "定义: 由内分泌组织构成并主要行使内分泌功能的器官"
            }
          ]
        },
        {
          "name": "内分泌系统",
          "children": [
            {
              "name": "组成: 内分泌腺和分散的内分泌细胞"
            }
          ]
        },
        {
          "name": "激素分泌方式",
          "children": [
            {
              "name": "远距分泌: 经血液循环到达靶细胞"
            },
            {
              "name": "旁分泌: 经组织液作用于邻近细胞"
            },
            {
              "name": "自分泌: 经组织液作用于自身细胞"
            },
            {
              "name": "神经内分泌: 神经细胞分泌激素"
            }
          ]
        },
        {
          "name": "激素化学分类",
          "children": [
            {
              "name": "含氮类激素",
              "children": [
                {
                  "name": "胺类: 肾上腺素、去甲肾上腺素、甲状腺激素"
                },
                {
                  "name": "肽与蛋白质类: 下丘脑调节肽、垂体激素、胰岛素"
                }
              ]
            },
            {
              "name": "脂类激素",
              "children": [
                {
                  "name": "类固醇(甾体)激素: 皮质醇、醛固酮、性激素"
                },
                {
                  "name": "脂肪酸衍生物: 前列腺素、血栓烷、白三烯"
                }
              ]
            }
          ]
        },
        {
          "name": "激素作用特征",
          "children": [
            {
              "name": "信息传递: 将信息传递给靶细胞"
            },
            {
              "name": "相对特异性: 作用于表达特异受体的靶器官"
            },
            {
              "name": "高效作用: 浓度低而作用显著"
            },
            {
              "name": "激素间相互作用: 协同、拮抗、允许、竞争"
            }
          ]
        }
      ]
    },
    {
      "name": "下丘脑与垂体",
      "children": [
        {
          "name": "下丘脑-神经垂体系统",
          "children": [
            {
              "name": "视上核与室旁核: 经下丘脑垂体束至神经垂体"
            },
            {
              "name": "抗利尿激素(ADH): 促进远曲小管和集合管重吸收水"
            },
            {
              "name": "催产素(OXT): 促进子宫平滑肌收缩与排乳"
            }
          ]
        },
        {
          "name": "下丘脑-腺垂体系统",
          "children": [
            {
              "name": "促垂体区: 经垂体门静脉调节腺垂体"
            },
            {
              "name": "释放及抑制激素: TRH、CRH、GHRH、GHRIH、PIH等"
            }
          ]
        },
        {
          "name": "腺垂体分泌激素",
          "children": [
            {
              "name": "作用于靶腺",
              "children": [
                {
                  "name": "促甲状腺激素(TSH): 作用于甲状腺"
                },
                {
                  "name": "促肾上腺皮质激素(ACTH): 作用于肾上腺皮质"
                },
                {
                  "name": "促卵泡激素(FSH)与黄体生成素(LH): 作用于性腺"
                }
              ]
            },
            {
              "name": "直接作用于靶组织",
              "children": [
                {
                  "name": "生长激素(GH): 促进骨骼生长与蛋白质合成"
                },
                {
                  "name": "催乳素(PRL): 促进乳腺发育与泌乳"
                },
                {
                  "name": "促黑激素(MSH): 作用于黑色素细胞"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "甲状腺与钙调节激素",
      "children": [
        {
          "name": "甲状腺激素",
          "children": [
            {
              "name": "成分: 三碘甲状腺原氨酸(T3)与四碘甲状腺原氨酸(T4)"
            },
            {
              "name": "代谢影响: 增加基础代谢率与产热效应"
            },
            {
              "name": "生长发育: 促进中枢神经系统发育与骨骼生长"
            },
            {
              "name": "调节机制: 下丘脑-腺垂体-甲状腺轴负反馈调节"
            }
          ]
        },
        {
          "name": "降钙素",
          "children": [
            {
              "name": "来源: 甲状腺滤泡旁细胞(C细胞)"
            },
            {
              "name": "生理作用: 抑制破骨细胞，降低血钙和血磷"
            }
          ]
        },
        {
          "name": "甲状旁腺素(PTH)",
          "children": [
            {
              "name": "来源: 甲状旁腺"
            },
            {
              "name": "生理作用: 动员骨钙入血，促进肾重吸收钙，升高血钙"
            }
          ]
        },
        {
          "name": "活性维生素D3",
          "children": [
            {
              "name": "生成: 经肝脏与肾脏羟化形成1,25-(OH)2VitD3"
            },
            {
              "name": "生理作用: 促进小肠粘膜对钙磷的吸收"
            }
          ]
        }
      ]
    },
    {
      "name": "肾上腺",
      "children": [
        {
          "name": "肾上腺皮质",
          "children": [
            {
              "name": "球状带: 分泌盐皮质激素(醛固酮)，保钠排钾"
            },
            {
              "name": "束状带: 分泌糖皮质激素(皮质醇)，升高血糖与抗炎"
            },
            {
              "name": "网状带: 分泌性激素(雄激素)"
            }
          ]
        },
        {
          "name": "肾上腺髓质",
          "children": [
            {
              "name": "分泌激素: 肾上腺素与去甲肾上腺素"
            },
            {
              "name": "调节方式: 受交感神经支配，参与应激反应"
            }
          ]
        }
      ]
    },
    {
      "name": "胰岛与血糖调节",
      "children": [
        {
          "name": "胰岛素",
          "children": [
            {
              "name": "来源: 胰岛B细胞"
            },
            {
              "name": "生理作用: 促进葡萄糖利用与合成代谢，唯一降糖激素"
            }
          ]
        },
        {
          "name": "胰高血糖素",
          "children": [
            {
              "name": "来源: 胰岛A细胞"
            },
            {
              "name": "生理作用: 促进糖原分解与糖异生，升高血糖"
            }
          ]
        },
        {
          "name": "血糖调节异常",
          "children": [
            {
              "name": "I型糖尿病: 胰岛素分泌减少"
            },
            {
              "name": "II型糖尿病: 胰岛素受体或下游信号异常"
            }
          ]
        }
      ]
    }
  ]
}